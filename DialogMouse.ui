  <property name="styleSheet">
   <string notr="true">*{color:white; }
#DialogMouse,#pag0{ background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0 #1F1F1F , stop:1 #191919);}

QLabel{color:white;font-size:16px;}
QCheckBox,QRadioButton{color:white;font-size:16px;}
QSpinBox{color:white;font-size:16px;}
QDoubleSpinBox{color:white;font-size:16px;}

QPushButton{font: 16px 'MiSans' bold; color:white; border: 1px solid white; background: none; min-height:32px;border-radius:16px; padding: 0 4px;}

        QSlider { border-radius: 12px; height: 24px; }
        QSlider::groove:horizontal { height: 10px; background: #393939; border-radius: 5px; }
        QSlider::sub-page:horizontal { background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #5C2CAE, stop:1 #5C2CAE);  border-radius: 5px; }
        QSlider::sub-page:horizontal:disabled { background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 white, stop:1 #B3B3B3);  border-radius: 5px; }
        QSlider::handle:horizontal:disabled { border: 2px solid #B3B3B3; }
        QSlider::handle:horizontal {
            width: 30px;
            height: 12px;
            margin: -3px 0;
            border-radius: 4px;
            background: white;
            border: none; }


QSpinBox {
    padding-left: 10px;
    padding-right: 10px;
	color:black;
	background-color:gray;
	border:2px solid #a1a1a1;
    text-align:center;
	border-radius:8px;
}
QSpinBox::up-button {
    subcontrol-position: right;
    right: 5px; /* 向左偏移（实验性，效果有限）*/

    width: 14px;
    height: 14px; 
    subcontrol-origin: border; 

    border: none;
    background-color: transparent;
    background-image: url(:/images/plug-normal.png);
    background-repeat: no-repeat;
    background-position: center;
}
QSpinBox::down-button {
    subcontrol-position: left;
    left: 5px;
    width: 14px;
    height: 14px; 
    subcontrol-origin: border; 

    border: none;
    background-color: transparent;
    background-image: url(:/images/minus-normal.png);
    background-repeat: no-repeat;
    background-position: center;
}
QSpinBox::up-button:disabled{
    background-image: url(:/images/plug-disabled.png);
}
QSpinBox::down-button:disabled{
    background-image: url(:/images/minus-disabled.png);
}</string>
