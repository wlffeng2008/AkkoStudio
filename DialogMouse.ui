                      <height>200</height>
                     </size>
                    </property>
                    <property name="styleSheet">
                     <string notr="true">        QSlider { border-radius: 12px; height: 24px; }

        QSlider::groove:vertical { width: 48px; background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #5C2CAE, stop:1 #5C2CAE); border-radius: 12px;}
        QSlider::groove:vertical:disabled { background: lightgray; }
        QSlider::handle:vertical:disabled { background: white; border: 2px solid #B3B3B3; }
        QSlider::sub-page:vertical { background:  #282828;;  border-radius: 12px; }
        QSlider::sub-page:vertical:disabled { background: lightgray; }
        QSlider::handle:vertical {
            width: 64px;
            height: 6px;
            margin: -2px -6px;
            border-radius: 3px;
            background: white ;
            border: 2px solid white; }</string>
                    </property>
                    <property name="minimum">
                     <number>0</number>
                    </property>
