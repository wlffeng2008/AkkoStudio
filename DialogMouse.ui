  <property name="styleSheet">
   <string notr="true">*{color:white;font-size:14px; }
*:disabled{color:darkgray; }
#DialogMouse,#pag0{ background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0 #1F1F1F , stop:1 #191919);}

QToolTip{color:black;}
QLabel{color:white;font-size:16px;}
QCheckBox,QRadioButton{color:white;font-size:16px;min-height:32px;}
QSpinBox{color:white;font-size:16px;}
QDoubleSpinBox{color:white;font-size:16px;}
#stackWidget{margin-left:20px;margin-bottom:20px;}
QPushButton{font: 16px 'MiSans' bold; color:white; border: 1px solid white; background: none; min-height:32px;border-radius:16px; padding: 0 4px;}

        QSlider { border-radius: 12px; height: 26px; }
        QSlider::groove:horizontal { height: 10px; background: #393939; border-radius: 5px; }
        QSlider::sub-page:horizontal { background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #5C2CAE, stop:1 #5C2CAE);  border-radius: 5px; }
        QSlider::sub-page:horizontal:disabled { background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 white, stop:1 #B3B3B3);  border-radius: 5px; }
        QSlider::handle:horizontal:disabled { border: 2px solid #B3B3B3; }
        QSlider::handle:horizontal {
            width: 22px;
            height:24px;
            margin: -8px 0;
            border-radius: 13px;
            background: white;
            border: 3px solid #5C2CAE ; }

 QMessageBox {min-width: 400px; min-height: 240px;}
 QMessageBox QPushButton {
                border: 1px solid #6C9F50;
                background-color: #6329B6;
                color: white;
                border-radius: 8px;
                padding: 2px 2px;
                min-width: 120px;
                min-height: 24px; }
QMessageBox QLabel#qt_msgbox_label{  color: black ; font-size:14px; min-width:340px; qproperty-alignment: AlignLeft ;}

QComboBox{color:white;font-size:16px;background-color:transparent;}
/* 右侧下拉按钮区域 */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width:24px;
    border-left:1px solid #666;
}

/* 下拉箭头 */
QComboBox::down-arrow {
    image: url(:/images/arrow-down.png);
    width:12px;
    height:12px;
}
/* ========== 下拉列表核心 ========== */
QComboBox QAbstractItemView {
    background-color: #2b2b2b; 
    color: #fff;
    border:1px solid #555;
    outline:0;
}

/* 列表条目 hover 悬浮背景 */
QComboBox QAbstractItemView::item:hover {
    background-color: #484848;
}

/* 列表条目选中背景 */
QComboBox QAbstractItemView::item:selected {
    background-color: #404040;
}

QSpinBox {
    padding-left: 10px;
    padding-right: 10px;
	color:white;
	background-color:transparent;
	border:2px solid #a1a1a1;
    text-align:center;
	border-radius:8px;
}
QSpinBox::up-button {
    subcontrol-position: right;
    right: 5px; /* 向左偏移（实验性，效果有限）*/

    width: 14px;
    height: 14px; 
    subcontrol-origin: border; 

    border: none;
    background-color: transparent;
    background-image: url(:/images/plug-disabled.png);
    background-repeat: no-repeat;
    background-position: center;
}
QSpinBox::down-button {
    subcontrol-position: left;
    left: 5px;
    width: 14px;
    height: 14px; 
    subcontrol-origin: border; 

    border: none;
    background-color: transparent;
    background-image: url(:/images/minus-disabled.png);
    background-repeat: no-repeat;
    background-position: center;
}
QSpinBox::up-button:disabled{
    background-image: url(:/images/plug-disabled.png);
}
QSpinBox::down-button:disabled{
    background-image: url(:/images/minus-disabled.png);
}

/* 整个QCheckBox */
QCheckBox {
    color: #fff;
    spacing: 8px; /* 方框和文字之间距离 */
}

/* 未选中 - 方框 */
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid gray;
    background-color: transparent;
}

/* 鼠标悬浮未选中 */
QCheckBox::indicator:hover {
    border-color: #409eff;
}

/* 选中状态 */
QCheckBox::indicator:checked {
    background-color: #6329B6;
    border-color: #6329B6;
    /* 对勾图标，用border画对勾，不用图片 */
    image: none;
}


/* 禁用状态 */
QCheckBox::indicator:disabled {
    border-color: #cccccc;
    background: #f5f5f5;
}
QCheckBox:disabled {
    color: #aaaaaa;
}

/* 单选框整体：文字颜色、字体、圆圈和文字间距 */
QRadioButton {
    color: #fff;
    spacing: 8px; /* 圆圈与文字之间距离，只能写在QRadioButton{} */
}

/* 未选中的圆形指示器 */
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 10px; /* 宽高一半，做成正圆 */
    border: 1px solid gray;
    background-color:  transparent;
    background: qradialgradient(
        cx:0.52, cy:0.52, radius:0.5,
        stop:0 transparent,
        stop:0.99 transparent,
        stop:1 gray
    );
}

/* 鼠标悬浮（未选中） */
QRadioButton::indicator:hover {
    border-color: gray;
}

/* 选中状态：外圈蓝色 + 内部小圆点 */
QRadioButton::indicator:checked {
    border: 0px solid #6329B6;

    background: qradialgradient(
        cx:0.52, cy:0.52, radius:0.5,
        stop:0 #6329B6,
        stop:0.99 #6329B6,
        stop:1 transparent
    );
}

/* 禁用状态 */
QRadioButton::indicator:disabled {
    border-color: #cccccc;
    background: #f5f5f5;
}
QRadioButton:disabled {
    color: #aaaaaa;
}

</string>
